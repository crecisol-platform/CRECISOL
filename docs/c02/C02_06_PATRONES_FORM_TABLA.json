  "negative_cases": [
    {
      "id": "NEG01",
      "attack": "submit synthetic draft as business form",
      "expected": "prevent native submit, emit no backend write and show local-only feedback"
    },
    {
      "id": "NEG02",
      "attack": "submit an empty required field while claiming the local preview is valid",
      "expected": "inline accessible error, no save or successful transaction acknowledgement"
    },
    {
      "id": "NEG03",
      "attack": "inject HTML or script into field or column values",
      "expected": "reject invalid config and field input, display table values as escaped text"
    },
    {
      "id": "NEG04",
      "attack": "discard dirty value with one click",
      "expected": "require native modal confirmation; cancel or Escape preserves draft"
    },
    {
      "id": "NEG05",
      "attack": "close browser with unsaved draft",
      "expected": "beforeunload confirmation hint while draft remains dirty"
    },
    {
      "id": "NEG06",
      "attack": "change tenant or schema after typing",
      "expected": "discard previous scope draft and require host authorization before new context"
    },
    {
      "id": "NEG07",
      "attack": "reopen another tenant table with stale filter",
      "expected": "clear filter and sort and demand authorized fresh host rows"
    },
    {
      "id": "NEG08",
      "attack": "empty view used to interpret HTTP 403",
      "expected": "local fixture empty never stands for server authorization or results"
    },
    {
      "id": "NEG09",
      "attack": "client alters column schema with HTML key or label",
      "expected": "reject unsafe schema using bounded text and key allowlist"
    },
    {
      "id": "NEG10",
      "attack": "sort or filter to enumerate private API records",
      "expected": "table never fetches data; host must limit results to authorized scope"
    },
    {
      "id": "NEG11",
      "attack": "test harness leaks to production route or bundle",
      "expected": "production index and main unchanged, no harness code in production output"
    },
    {
      "id": "NEG12",
      "attack": "malicious keyboard or 320px layout hides controls",
      "expected": "native focus/semantic form/table, visible navigation and horizontally scrollable table"
    },
    {
      "id": "NEG13",
      "attack": "SuperAdmin bypasses exceptional PII constraints",
      "expected": "patterns never grant permission and future backend requires MFA reason expiry audit"
    },
    {
      "id": "NEG14",
      "attack": "private cross-tenant path hit while testing demo patterns",
      "expected": "existing four-route allowlist stays unchanged and unknown path uses NotFound"
    }
  ]
