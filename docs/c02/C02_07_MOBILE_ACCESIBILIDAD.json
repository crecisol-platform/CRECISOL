  "negative_cases": [
    {
      "id": "NEG01",
      "attack": "narrow 320 pixel mobile header hides a visible public navigation link",
      "expected": "all three home links and four public-information links remain visibly operable by touch and keyboard"
    },
    {
      "id": "NEG02",
      "attack": "inline anchor min-height falsely passes a 44 CSS pixel touch-target assertion",
      "expected": "real rendered element geometry must be at least 44 CSS pixels in width and height"
    },
    {
      "id": "NEG03",
      "attack": "validated publication includes long unbroken company-brand text and forces page overflow",
      "expected": "user-supplied published name and slogan wrap without horizontal document scrolling or code injection"
    },
    {
      "id": "NEG04",
      "attack": "200 percent user font resizing clips primary actions or hides an essential link",
      "expected": "content reflows without document-level horizontal scrolling and all public links remain visible"
    },
    {
      "id": "NEG05",
      "attack": "skip to main changes URL fragment but leaves keyboard focus trapped in header",
      "expected": "tabbable skip link focuses an actual main landmark that accepts programmatic focus"
    },
    {
      "id": "NEG06",
      "attack": "failed platform publication retains stale metadata, logo or prior tenant copy",
      "expected": "error view clears old public identity and only shows an explicit keyboard-operable retry"
    },
    {
      "id": "NEG07",
      "attack": "prefers-reduced-motion is ignored and progress animation keeps moving",
      "expected": "motion is nonessential and reduced-motion users receive still progress and stable navigation"
    },
    {
      "id": "NEG08",
      "attack": "forced-colors accessibility mode removes focus affordance in the public header",
      "expected": "focus outline remains visible with system colors without trusting brand tokens"
    },
    {
      "id": "NEG09",
      "attack": "unknown private path becomes accessible through a mobile-only menu or URL",
      "expected": "four public routes plus wildcard not-found remain the only allowable runtime navigation"
    },
    {
      "id": "NEG10",
      "attack": "frontend browser sets tenant id or scope in query to authorize private resources",
      "expected": "only same-origin published platform read model is fetched without credentials or tenant headers"
    },
    {
      "id": "NEG11",
      "attack": "synthetic Angular form/table harness appears in production route or JavaScript bundle",
      "expected": "independent 4201 test-only Angular entrypoint stays out of production routes and assets"
    },
    {
      "id": "NEG12",
      "attack": "table scrollable area forces all of the mobile document to horizontal-scroll",
      "expected": "only named keyboard-focusable table region scrolls horizontally while document remains within viewport"
    },
    {
      "id": "NEG13",
      "attack": "dirty form changes example scope without a native confirm/cancel dialog",
      "expected": "scope change remains gated by modal and old draft stays until explicit confirmed discard"
    },
    {
      "id": "NEG14",
      "attack": "synthetic field values are interpreted as HTML during zoom or font switching",
      "expected": "render all values through safe Angular text interpolation and reject unsafe user configured inputs"
    },
    {
      "id": "NEG15",
      "attack": "automated WCAG smoke is presented as full manual screen-reader certification",
      "expected": "report only automated axe tests and document manual device and assistive-technology limitations"
    },
    {
      "id": "NEG16",
      "attack": "mobile responsive work adds form submission, privileged API or backend mutation",
      "expected": "no new private route, backend or database change and no claim of implemented RBAC or MFA"
    }
  ]
