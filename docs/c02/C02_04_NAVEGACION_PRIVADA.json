    },
    {
      "id": "DEN02",
      "attack": "Cross-tenant/cross-branch IDOR/BOLA and resource-owner forgery",
      "expected": "never return another tenant, branch or consumer resource"
    },
    {
      "id": "DEN03",
      "attack": "SuperAdmin attempts private PII without MFA reason expiry audit",
      "expected": "deny exceptional access until justified, timed and audited"
    },
    {
      "id": "DEN04",
      "attack": "Employee denied finance or assignment revoked mid-session",
      "expected": "no financial projection and deny removed permissions immediately"
    },
    {
      "id": "DEN05",
      "attack": "Consumer opens other customer's document, receipt or backup",
      "expected": "deny private media, exports, logs, previews and backups"
    },
    {
      "id": "DEN06",
      "attack": "Malicious menu config injects route HTML JS permission icon or tenant",
      "expected": "reject untrusted fields and never widen backend authorization"
    },
    {
      "id": "DEN07",
      "attack": "Old tab/cache/SSR request replays previous tenant after context change",
      "expected": "discard previous context data and require fresh backend decision"
    },
    {
      "id": "DEN08",
      "attack": "Host switches MySQL DSN with query parameter or header",
      "expected": "backend catalog selects storage; client cannot choose database"
    },
    {
      "id": "DEN09",
      "attack": "Unpublished public tenant catalog rendered via forged host",
      "expected": "never disclose drafts or private consumer data"
    },
    {
      "id": "DEN10",
      "attack": "UI guard hides route but attacker uses API directly",
      "expected": "server checks identity tenant membership action branch and ownership"
    },
    {
      "id": "DEN11",
      "attack": "Demo uses production accounts or payment method",
      "expected": "synthetic-only future demo no real accounts charges or checkout"
    },
    {
      "id": "DEN12",
      "attack": "User manually browses proposed private route before its backend exists",
      "expected": "current Angular wildcard remains NotFoundComponent with no private content"
    }
  ],
