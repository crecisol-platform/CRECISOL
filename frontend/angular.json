{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "crecisol-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "cs",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/crecisol-web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "budgets": []
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "340kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "14kB",
                  "maximumError": "22kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "pattern-harness": {
              "optimization": false,
              "sourceMap": true,
              "browser": "tests/pattern-harness/main.ts",
              "index": "tests/pattern-harness/index.html",
              "tsConfig": "tsconfig.patterns.json",
              "outputPath": "dist/crecisol-pattern-harness",
              "assets": []
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "crecisol-web:build:development",
              "proxyConfig": "proxy.conf.json"
            },
            "pattern-harness": {
              "buildTarget": "crecisol-web:build:pattern-harness"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
