    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@playwright/test": "1.56.1",
    "@axe-core/playwright": "4.10.2",
    "typescript": "6.0.3"
  }
